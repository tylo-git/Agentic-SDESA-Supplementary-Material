      },
      "case-activities-middle": {
        "kind": "document",
        "locator": "case/Double_Resource_Scheduling_Case_P25_Narrative.md#line=7",
        "text": "A→D/E，B→F/G，C→G；D/E/F/G 的工期与资源需求。"
      },
